  "clips": [
    { "voice": "earth_lector", "text": "The Mercy will be cleansed.", "norm": "THE MERCY WILL BE CLEANSED.", "intensity": "calm", "file": "vo/earth_lector/earth_bombers_01.ogg", "seconds": 7.83, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Your ark is a coffin. We will close it.", "norm": "YOUR ARK IS A COFFIN. WE WILL CLOSE IT.", "intensity": "calm", "file": "vo/earth_lector/earth_bombers_02.ogg", "seconds": 8.95, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Biologics. You were us, once.", "norm": "BIOLOGICS. YOU WERE US, ONCE.", "intensity": "calm", "file": "vo/earth_lector/earth_wave_01.ogg", "seconds": 9.12, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "The fallen return to be unmade.", "norm": "THE FALLEN RETURN TO BE UNMADE.", "intensity": "calm", "file": "vo/earth_lector/earth_wave_02.ogg", "seconds": 7.76, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Kneel, remnant. Or burn where you are.", "norm": "KNEEL, REMNANT. OR BURN WHERE YOU ARE.", "intensity": "calm", "file": "vo/earth_lector/earth_wave_03.ogg", "seconds": 8.70, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Your blood remembers Earth. Earth does not remember you.", "norm": "YOUR BLOOD REMEMBERS EARTH. EARTH DOES NOT REMEMBER YOU.", "intensity": "calm", "file": "vo/earth_lector/earth_wave_04.ogg", "seconds": 10.42, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Burn it. Burn all of it.", "norm": "BURN IT. BURN ALL OF IT.", "intensity": "calm", "file": "vo/earth_lector/escort_incense.ogg", "seconds": 7.97, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Every remnant ends. Yours ends here.", "norm": "EVERY REMNANT ENDS. YOURS ENDS HERE.", "intensity": "calm", "file": "vo/earth_lector/escort_lauds.ogg", "seconds": 9.50, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Lector. You carry four hundred biologics. We will count them as they freeze.", "norm": "LECTOR. YOU CARRY FOUR HUNDRED BIOLOGICS. WE WILL COUNT THEM AS THEY FREEZE.", "intensity": "calm", "file": "vo/earth_lector/escort_lector_here.ogg", "seconds": 13.89, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "A vessel of the fallen, crawling home. How touching.", "norm": "A VESSEL OF THE FALLEN, CRAWLING HOME. HOW TOUCHING.", "intensity": "calm", "file": "vo/earth_lector/escort_matins.ogg", "seconds": 9.77, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "You brought them to us. That was a kindness.", "norm": "YOU BROUGHT THEM TO US. THAT WAS A KINDNESS.", "intensity": "calm", "file": "vo/earth_lector/escort_prime.ogg", "seconds": 9.99, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "There you are.", "norm": "THERE YOU ARE.", "intensity": "calm", "file": "vo/earth_lector/escort_spotted.ogg", "seconds": 5.84, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "The door you run for is a grave. Go on.", "norm": "THE DOOR YOU RUN FOR IS A GRAVE. GO ON.", "intensity": "calm", "file": "vo/earth_lector/escort_terce.ogg", "seconds": 8.99, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Censers, go. Bring me the ark.", "norm": "CENSERS, GO. BRING ME THE ARK.", "intensity": "calm", "file": "vo/earth_lector/escort_thurible.ogg", "seconds": 8.49, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "The Mercy will be cleansed.", "norm": "THE MERCY WILL BE CLEANSED.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_bombers.ogg", "seconds": 7.25, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "Biologics. You were us, once.", "norm": "BIOLOGICS. YOU WERE US, ONCE.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_1.ogg", "seconds": 9.50, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "The fallen return to be unmade.", "norm": "THE FALLEN RETURN TO BE UNMADE.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_2.ogg", "seconds": 8.91, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "Kneel, remnant. Or burn where you are.", "norm": "KNEEL, REMNANT. OR BURN WHERE YOU ARE.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_3.ogg", "seconds": 8.54, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "Your blood remembers Earth. Earth does not remember you.", "norm": "YOUR BLOOD REMEMBERS EARTH. EARTH DOES NOT REMEMBER YOU.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_4.ogg", "seconds": 9.76, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "The dark between the stars was ours before you crawled into it.", "norm": "THE DARK BETWEEN THE STARS WAS OURS BEFORE YOU CRAWLED INTO IT.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_5.ogg", "seconds": 10.88, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "This is the last of your kind\u0027s courage. Spend it.", "norm": "THIS IS THE LAST OF YOUR KIND\u0027S COURAGE. SPEND IT.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_6.ogg", "seconds": 9.12, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "Your ark is a coffin. We will close it.", "norm": "YOUR ARK IS A COFFIN. WE WILL CLOSE IT.", "intensity": "calm", "file": "vo/earth_warden/earth_bombers_02.ogg", "seconds": 9.12, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "Burn it. Burn all of it.", "norm": "BURN IT. BURN ALL OF IT.", "intensity": "calm", "file": "vo/earth_warden/escort_incense.ogg", "seconds": 8.08, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "Every remnant ends. Yours ends here.", "norm": "EVERY REMNANT ENDS. YOURS ENDS HERE.", "intensity": "calm", "file": "vo/earth_warden/escort_lauds.ogg", "seconds": 8.88, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "A vessel of the fallen, crawling home. How touching.", "norm": "A VESSEL OF THE FALLEN, CRAWLING HOME. HOW TOUCHING.", "intensity": "calm", "file": "vo/earth_warden/escort_matins.ogg", "seconds": 10.16, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "You brought them to us. That was a kindness.", "norm": "YOU BROUGHT THEM TO US. THAT WAS A KINDNESS.", "intensity": "calm", "file": "vo/earth_warden/escort_prime.ogg", "seconds": 9.04, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "The door you run for is a grave. Go on.", "norm": "THE DOOR YOU RUN FOR IS A GRAVE. GO ON.", "intensity": "calm", "file": "vo/earth_warden/escort_terce.ogg", "seconds": 9.50, "lufs": -21.0 },
    { "voice": "lantern", "text": "Lantern flight, jumping in. Sorry we\u0027re late. Traffic.", "norm": "LANTERN FLIGHT, JUMPING IN. SORRY WE\u0027RE LATE. TRAFFIC.", "intensity": "tense", "file": "vo/lantern/escort_lantern_tense.ogg", "seconds": 2.33, "lufs": -21.5 },
    { "voice": "mercy", "text": "That\u0027s their big guns gone. Returning the favour.", "norm": "THAT\u0027S THEIR BIG GUNS GONE. RETURNING THE FAVOUR.", "intensity": "tense", "file": "vo/mercy/beams_down_02_tense.ogg", "seconds": 2.30, "lufs": -21.5 },
    { "voice": "mercy", "text": "That\u0027s a beam. Somebody shut those turrets up before it cuts us in half.", "norm": "THAT\u0027S A BEAM. SOMEBODY SHUT THOSE TURRETS UP BEFORE IT CUTS US IN HALF.", "intensity": "frantic", "file": "vo/mercy/beams_threat_02_frantic.ogg", "seconds": 3.08, "lufs": -19.5 },
    { "voice": "mercy", "text": "Torpedo boats on approach. We\u0027d appreciate the company.", "norm": "TORPEDO BOATS ON APPROACH. WE\u0027D APPRECIATE THE COMPANY.", "intensity": "frantic", "file": "vo/mercy/bombers_02_frantic.ogg", "seconds": 2.34, "lufs": -19.5 },
    { "voice": "mercy", "text": "We\u0027re bleeding air down here.", "norm": "WE\u0027RE BLEEDING AIR DOWN HERE.", "intensity": "frantic", "file": "vo/mercy/capital_hurt_02_frantic.ogg", "seconds": 1.52, "lufs": -19.5 },
    { "voice": "mercy", "text": "Warden\u0027s beams are quiet. Ours are free. Thank you.", "norm": "WARDEN\u0027S BEAMS ARE QUIET. OURS ARE FREE. THANK YOU.", "intensity": "tense", "file": "vo/mercy/dogfight_beams_down_tense.ogg", "seconds": 2.43, "lufs": -21.5 },
    { "voice": "mercy", "text": "Mercy here. The Warden\u0027s charging beams at us. Its two beam turrets, forward, on top. Take them out.", "norm": "MERCY HERE. THE WARDEN\u0027S CHARGING BEAMS AT US. ITS TWO BEAM TURRETS, FORWARD, ON TOP. TAKE THEM OUT.", "intensity": "frantic", "file": "vo/mercy/dogfight_beams_threat_frantic.ogg", "seconds": 4.61, "lufs": -19.5 },
    { "voice": "mercy", "text": "Bombers inbound on the Mercy. Somebody deal with them.", "norm": "BOMBERS INBOUND ON THE MERCY. SOMEBODY DEAL WITH THEM.", "intensity": "frantic", "file": "vo/mercy/dogfight_bombers_frantic.ogg", "seconds": 2.39, "lufs": -19.5 },
    { "voice": "mercy", "text": "Mercy here. Hull\u0027s going. Any time now.", "norm": "MERCY HERE. HULL\u0027S GOING. ANY TIME NOW.", "intensity": "frantic", "file": "vo/mercy/dogfight_capital_hurt_frantic.ogg", "seconds": 1.97, "lufs": -19.5 },
    { "voice": "mercy", "text": "Sable flight, Warden\u0027s three klicks out. Keep the drones off us and we\u0027ll all get home.", "norm": "SABLE FLIGHT, WARDEN\u0027S THREE KLICKS OUT. KEEP THE DRONES OFF US AND WE\u0027LL ALL GET HOME.", "intensity": "tense", "file": "vo/mercy/dogfight_opening_tense.ogg", "seconds": 3.84, "lufs": -21.5 },
    { "voice": "sable1", "text": "Mercy\u0027s gone.", "norm": "MERCY\u0027S GONE.", "intensity": "frantic", "file": "vo/sable1/dogfight_lost_capital_frantic.ogg", "seconds": 1.14, "lufs": -19.5 },
    { "voice": "sable1", "text": "Sable 2 is gone.", "norm": "SABLE 2 IS GONE.", "intensity": "frantic", "file": "vo/sable1/dogfight_sable2_lost_frantic.ogg", "seconds": 1.25, "lufs": -19.5 },
    { "voice": "sable1", "text": "Lost Sable 3. Keep flying.", "norm": "LOST SABLE 3. KEEP FLYING.", "intensity": "frantic", "file": "vo/sable1/dogfight_sable3_lost_frantic.ogg", "seconds": 1.86, "lufs": -19.5 },
    { "voice": "sable1", "text": "That\u0027s the lot. Warden\u0027s gone.", "norm": "THAT\u0027S THE LOT. WARDEN\u0027S GONE.", "intensity": "calm", "file": "vo/sable1/dogfight_won.ogg", "seconds": 2.43, "lufs": -23.0 },
    { "voice": "sable1", "text": "Lector\u0027s breaking up. Shame.", "norm": "LECTOR\u0027S BREAKING UP. SHAME.", "intensity": "tense", "file": "vo/sable1/escort_lector_down_tense.ogg", "seconds": 1.59, "lufs": -21.5 },
    { "voice": "sable1", "text": "Tamsin\u0027s gone. All of them.", "norm": "TAMSIN\u0027S GONE. ALL OF THEM.", "intensity": "frantic", "file": "vo/sable1/escort_lost_frantic.ogg", "seconds": 1.65, "lufs": -19.5 },
