  "clips": [
    { "voice": "earth_lector", "text": "Wreckage. The fallen leave their dead everywhere.", "norm": "WRECKAGE. THE FALLEN LEAVE THEIR DEAD EVERYWHERE.", "intensity": "calm", "file": "vo/earth_lector/cabin_lector_blind.ogg", "seconds": 10.64, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Hiding in the dark. We will find you.", "norm": "HIDING IN THE DARK. WE WILL FIND YOU.", "intensity": "calm", "file": "vo/earth_lector/cabin_lector_here.ogg", "seconds": 9.52, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Sweeping for life.", "norm": "SWEEPING FOR LIFE.", "intensity": "calm", "file": "vo/earth_lector/cabin_lector_sweep.ogg", "seconds": 7.28, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "I see you. All of you.", "norm": "I SEE YOU. ALL OF YOU.", "intensity": "calm", "file": "vo/earth_lector/cabin_spotted.ogg", "seconds": 7.58, "lufs": -21.1 },
    { "voice": "earth_lector", "text": "The Mercy will be cleansed.", "norm": "THE MERCY WILL BE CLEANSED.", "intensity": "calm", "file": "vo/earth_lector/earth_bombers_01.ogg", "seconds": 7.83, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "You have chosen your own destruction. Do not hate us for what we do.", "norm": "YOU HAVE CHOSEN YOUR OWN DESTRUCTION. DO NOT HATE US FOR WHAT WE DO.", "intensity": "calm", "file": "vo/earth_lector/earth_bombers_02.ogg", "seconds": 12.26, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "We were once like you. We have ascended.", "norm": "WE WERE ONCE LIKE YOU. WE HAVE ASCENDED.", "intensity": "calm", "file": "vo/earth_lector/earth_wave_01.ogg", "seconds": 9.52, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "The fallen return to be unmade.", "norm": "THE FALLEN RETURN TO BE UNMADE.", "intensity": "calm", "file": "vo/earth_lector/earth_wave_02.ogg", "seconds": 7.76, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Disable your shields, and prepare for your ascension.", "norm": "DISABLE YOUR SHIELDS, AND PREPARE FOR YOUR ASCENSION.", "intensity": "calm", "file": "vo/earth_lector/earth_wave_03.ogg", "seconds": 10.30, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "You remember Earth. Earth does not remember you.", "norm": "YOU REMEMBER EARTH. EARTH DOES NOT REMEMBER YOU.", "intensity": "calm", "file": "vo/earth_lector/earth_wave_04.ogg", "seconds": 10.09, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Burn it. Burn all of it.", "norm": "BURN IT. BURN ALL OF IT.", "intensity": "calm", "file": "vo/earth_lector/escort_incense.ogg", "seconds": 7.97, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Those we leave behind will remain in eternal darkness. Ascend with us now. It is your only hope.", "norm": "THOSE WE LEAVE BEHIND WILL REMAIN IN ETERNAL DARKNESS. ASCEND WITH US NOW. IT IS YOUR ONLY HOPE.", "intensity": "calm", "file": "vo/earth_lector/escort_lauds.ogg", "seconds": 14.13, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "We can sense four hundred and fifty two of you on that vessel. Join us now and free yourself from suffering.", "norm": "WE CAN SENSE FOUR HUNDRED AND FIFTY TWO OF YOU ON THAT VESSEL. JOIN US NOW AND FREE YOURSELF FROM SUFFERING.", "intensity": "calm", "file": "vo/earth_lector/escort_lector_here.ogg", "seconds": 14.14, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "What are these things that resist?", "norm": "WHAT ARE THESE THINGS THAT RESIST?", "intensity": "calm", "file": "vo/earth_lector/escort_matins.ogg", "seconds": 7.83, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "We only wish to release you from your suffering. Disable your shields now to embrace your ascension.", "norm": "WE ONLY WISH TO RELEASE YOU FROM YOUR SUFFERING. DISABLE YOUR SHIELDS NOW TO EMBRACE YOUR ASCENSION.", "intensity": "calm", "file": "vo/earth_lector/escort_prime.ogg", "seconds": 15.19, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "There you are.", "norm": "THERE YOU ARE.", "intensity": "calm", "file": "vo/earth_lector/escort_spotted.ogg", "seconds": 5.84, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Fighting only prolongs your suffering.", "norm": "FIGHTING ONLY PROLONGS YOUR SUFFERING.", "intensity": "calm", "file": "vo/earth_lector/escort_terce.ogg", "seconds": 7.92, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Our congress grows - join it, and leave your prison.", "norm": "OUR CONGRESS GROWS - JOIN IT, AND LEAVE YOUR PRISON.", "intensity": "calm", "file": "vo/earth_lector/escort_terce2.ogg", "seconds": 10.80, "lufs": -21.0 },
    { "voice": "earth_lector", "text": "Bring them to me.", "norm": "BRING THEM TO ME.", "intensity": "calm", "file": "vo/earth_lector/escort_thurible.ogg", "seconds": 6.80, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "The Mercy will be cleansed.", "norm": "THE MERCY WILL BE CLEANSED.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_bombers.ogg", "seconds": 7.25, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "We were once like you. We have ascended.", "norm": "WE WERE ONCE LIKE YOU. WE HAVE ASCENDED.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_1.ogg", "seconds": 10.56, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "You return to us, and you will be ascended.", "norm": "YOU RETURN TO US, AND YOU WILL BE ASCENDED.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_2.ogg", "seconds": 10.00, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "Disable your shields, and prepare for your ascension.", "norm": "DISABLE YOUR SHIELDS, AND PREPARE FOR YOUR ASCENSION.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_3.ogg", "seconds": 10.95, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "You remember Earth. Earth does not remember you.", "norm": "YOU REMEMBER EARTH. EARTH DOES NOT REMEMBER YOU.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_4.ogg", "seconds": 9.84, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "You have no place here anymore.", "norm": "YOU HAVE NO PLACE HERE ANYMORE.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_5.ogg", "seconds": 8.63, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "This will all be over soon.", "norm": "THIS WILL ALL BE OVER SOON.", "intensity": "calm", "file": "vo/earth_warden/dogfight_earth_wave_6.ogg", "seconds": 7.37, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "You have chosen your own destruction. Do not hate us for what we do.", "norm": "YOU HAVE CHOSEN YOUR OWN DESTRUCTION. DO NOT HATE US FOR WHAT WE DO.", "intensity": "calm", "file": "vo/earth_warden/earth_bombers_02.ogg", "seconds": 11.04, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "The fallen return to be unmade.", "norm": "THE FALLEN RETURN TO BE UNMADE.", "intensity": "calm", "file": "vo/earth_warden/earth_wave_02.ogg", "seconds": 8.91, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "Burn it. Burn all of it.", "norm": "BURN IT. BURN ALL OF IT.", "intensity": "calm", "file": "vo/earth_warden/escort_incense.ogg", "seconds": 8.08, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "Those we leave behind will remain in eternal darkness. Ascend with us now. It is your only hope.", "norm": "THOSE WE LEAVE BEHIND WILL REMAIN IN ETERNAL DARKNESS. ASCEND WITH US NOW. IT IS YOUR ONLY HOPE.", "intensity": "calm", "file": "vo/earth_warden/escort_lauds.ogg", "seconds": 12.93, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "What are these things that resist?", "norm": "WHAT ARE THESE THINGS THAT RESIST?", "intensity": "calm", "file": "vo/earth_warden/escort_matins.ogg", "seconds": 7.50, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "We only wish to release you from your suffering. Disable your shields now to embrace your ascension.", "norm": "WE ONLY WISH TO RELEASE YOU FROM YOUR SUFFERING. DISABLE YOUR SHIELDS NOW TO EMBRACE YOUR ASCENSION.", "intensity": "calm", "file": "vo/earth_warden/escort_prime.ogg", "seconds": 15.20, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "Fighting only prolongs your suffering.", "norm": "FIGHTING ONLY PROLONGS YOUR SUFFERING.", "intensity": "calm", "file": "vo/earth_warden/escort_terce.ogg", "seconds": 8.69, "lufs": -21.0 },
    { "voice": "earth_warden", "text": "Our congress grows - join it, and leave your prison.", "norm": "OUR CONGRESS GROWS - JOIN IT, AND LEAVE YOUR PRISON.", "intensity": "calm", "file": "vo/earth_warden/escort_terce2.ogg", "seconds": 10.00, "lufs": -21.0 },
    { "voice": "lantern", "text": "Lantern flight, jumping in. Sorry we\u0027re late. Hope we didn\u0027t miss much.", "norm": "LANTERN FLIGHT, JUMPING IN. SORRY WE\u0027RE LATE. HOPE WE DIDN\u0027T MISS MUCH.", "intensity": "tense", "file": "vo/lantern/escort_lantern_tense.ogg", "seconds": 2.92, "lufs": -21.5 },
    { "voice": "mercy", "text": "Warden\u0027s beams are quiet. Ours are free. Thank you.", "norm": "WARDEN\u0027S BEAMS ARE QUIET. OURS ARE FREE. THANK YOU.", "intensity": "tense", "file": "vo/mercy/beams_down_01_tense.ogg", "seconds": 2.44, "lufs": -21.5 },
    { "voice": "mercy", "text": "That\u0027s their big guns gone. Returning the favour.", "norm": "THAT\u0027S THEIR BIG GUNS GONE. RETURNING THE FAVOUR.", "intensity": "tense", "file": "vo/mercy/beams_down_02_tense.ogg", "seconds": 2.30, "lufs": -21.5 },
    { "voice": "mercy", "text": "That\u0027s a beam. Somebody shut those turrets up before it cuts us in half.", "norm": "THAT\u0027S A BEAM. SOMEBODY SHUT THOSE TURRETS UP BEFORE IT CUTS US IN HALF.", "intensity": "frantic", "file": "vo/mercy/beams_threat_02_frantic.ogg", "seconds": 3.08, "lufs": -19.5 },
    { "voice": "mercy", "text": "Torpedo boats on approach. We\u0027d appreciate the company.", "norm": "TORPEDO BOATS ON APPROACH. WE\u0027D APPRECIATE THE COMPANY.", "intensity": "frantic", "file": "vo/mercy/bombers_02_frantic.ogg", "seconds": 2.34, "lufs": -19.5 },
    { "voice": "mercy", "text": "We\u0027re bleeding air down here.", "norm": "WE\u0027RE BLEEDING AIR DOWN HERE.", "intensity": "frantic", "file": "vo/mercy/capital_hurt_02_frantic.ogg", "seconds": 1.52, "lufs": -19.5 },
    { "voice": "mercy", "text": "Warden\u0027s beam weapon is down!!!", "norm": "WARDEN\u0027S BEAM WEAPON IS DOWN!!!", "intensity": "tense", "file": "vo/mercy/dogfight_beams_down_tense.ogg", "seconds": 1.63, "lufs": -21.5 },
    { "voice": "mercy", "text": "Mercy here. The Warden\u0027s charging beams at us. Its two beam turrets, forward, on top. Take them out.", "norm": "MERCY HERE. THE WARDEN\u0027S CHARGING BEAMS AT US. ITS TWO BEAM TURRETS, FORWARD, ON TOP. TAKE THEM OUT.", "intensity": "frantic", "file": "vo/mercy/dogfight_beams_threat_frantic.ogg", "seconds": 4.61, "lufs": -19.5 },
    { "voice": "mercy", "text": "Bombers inbound on the Mercy. Somebody deal with them.", "norm": "BOMBERS INBOUND ON THE MERCY. SOMEBODY DEAL WITH THEM.", "intensity": "frantic", "file": "vo/mercy/dogfight_bombers_frantic.ogg", "seconds": 2.39, "lufs": -19.5 },
    { "voice": "mercy", "text": "Mercy here. Hull\u0027s going. Any time now.", "norm": "MERCY HERE. HULL\u0027S GOING. ANY TIME NOW.", "intensity": "frantic", "file": "vo/mercy/dogfight_capital_hurt_frantic.ogg", "seconds": 1.97, "lufs": -19.5 },
    { "voice": "mercy", "text": "Sable flight, Warden\u0027s three klicks out. Keep the drones off us and we\u0027ll all get home.", "norm": "SABLE FLIGHT, WARDEN\u0027S THREE KLICKS OUT. KEEP THE DRONES OFF US AND WE\u0027LL ALL GET HOME.", "intensity": "tense", "file": "vo/mercy/dogfight_opening_tense.ogg", "seconds": 3.84, "lufs": -21.5 },
    { "voice": "sable1", "text": "Mercy\u0027s gone.", "norm": "MERCY\u0027S GONE.", "intensity": "frantic", "file": "vo/sable1/dogfight_lost_capital_frantic.ogg", "seconds": 1.14, "lufs": -19.5 },
    { "voice": "sable1", "text": "Sable 2 is gone.", "norm": "SABLE 2 IS GONE.", "intensity": "frantic", "file": "vo/sable1/dogfight_sable2_lost_frantic.ogg", "seconds": 1.25, "lufs": -19.5 },
    { "voice": "sable1", "text": "Lost Sable 3. Keep flying.", "norm": "LOST SABLE 3. KEEP FLYING.", "intensity": "frantic", "file": "vo/sable1/dogfight_sable3_lost_frantic.ogg", "seconds": 1.86, "lufs": -19.5 },
    { "voice": "sable1", "text": "That\u0027s the lot. Warden\u0027s gone.", "norm": "THAT\u0027S THE LOT. WARDEN\u0027S GONE.", "intensity": "calm", "file": "vo/sable1/dogfight_won.ogg", "seconds": 2.43, "lufs": -23.0 },
    { "voice": "sable1", "text": "Oh my God, the Lector is breaking up!!! Look at it!!!", "norm": "OH MY GOD, THE LECTOR IS BREAKING UP!!! LOOK AT IT!!!", "intensity": "tense", "file": "vo/sable1/escort_lector_down_tense.ogg", "seconds": 2.76, "lufs": -21.5 },
    { "voice": "sable1", "text": "Tamsin\u0027s gone. All of them.", "norm": "TAMSIN\u0027S GONE. ALL OF THEM.", "intensity": "frantic", "file": "vo/sable1/escort_lost_frantic.ogg", "seconds": 1.65, "lufs": -19.5 },
    { "voice": "sable1", "text": "We lost the Mercy.", "norm": "WE LOST THE MERCY.", "intensity": "frantic", "file": "vo/sable1/lost_capital_02_frantic.ogg", "seconds": 1.39, "lufs": -19.5 },
    { "voice": "sable1", "text": "Area\u0027s quiet. Let\u0027s not stay.", "norm": "AREA\u0027S QUIET. LET\u0027S NOT STAY.", "intensity": "calm", "file": "vo/sable1/won_02.ogg", "seconds": 2.71, "lufs": -23.0 },
    { "voice": "sable2", "text": "Copy. Going in.", "norm": "COPY. GOING IN.", "intensity": "frantic", "file": "vo/sable2/ack_attack_01_frantic.ogg", "seconds": 1.24, "lufs": -19.5 },
    { "voice": "sable2", "text": "Copy. Going in.", "norm": "COPY. GOING IN.", "intensity": "tense", "file": "vo/sable2/ack_attack_01_tense.ogg", "seconds": 1.15, "lufs": -21.5 },
    { "voice": "sable2", "text": "Your target. On it.", "norm": "YOUR TARGET. ON IT.", "intensity": "frantic", "file": "vo/sable2/ack_attack_02_frantic.ogg", "seconds": 1.47, "lufs": -19.5 },
    { "voice": "sable2", "text": "Your target. On it.", "norm": "YOUR TARGET. ON IT.", "intensity": "tense", "file": "vo/sable2/ack_attack_02_tense.ogg", "seconds": 1.44, "lufs": -21.5 },
    { "voice": "sable2", "text": "Engaging. Don\u0027t wait up.", "norm": "ENGAGING. DON\u0027T WAIT UP.", "intensity": "frantic", "file": "vo/sable2/ack_attack_03_frantic.ogg", "seconds": 1.61, "lufs": -19.5 },
    { "voice": "sable2", "text": "Engaging. Don\u0027t wait up.", "norm": "ENGAGING. DON\u0027T WAIT UP.", "intensity": "tense", "file": "vo/sable2/ack_attack_03_tense.ogg", "seconds": 1.60, "lufs": -21.5 },
    { "voice": "sable2", "text": "On your six.", "norm": "ON YOUR SIX.", "intensity": "frantic", "file": "vo/sable2/ack_cover_01_frantic.ogg", "seconds": 1.04, "lufs": -19.5 },
    { "voice": "sable2", "text": "On your six.", "norm": "ON YOUR SIX.", "intensity": "tense", "file": "vo/sable2/ack_cover_01_tense.ogg", "seconds": 1.05, "lufs": -21.5 },
    { "voice": "sable2", "text": "Covering you. Try not to make it interesting.", "norm": "COVERING YOU. TRY NOT TO MAKE IT INTERESTING.", "intensity": "frantic", "file": "vo/sable2/ack_cover_02_frantic.ogg", "seconds": 2.27, "lufs": -19.5 },
    { "voice": "sable2", "text": "Covering you. Try not to make it interesting.", "norm": "COVERING YOU. TRY NOT TO MAKE IT INTERESTING.", "intensity": "tense", "file": "vo/sable2/ack_cover_02_tense.ogg", "seconds": 2.47, "lufs": -21.5 },
    { "voice": "sable2", "text": "I\u0027ve got your back. For now.", "norm": "I\u0027VE GOT YOUR BACK. FOR NOW.", "intensity": "frantic", "file": "vo/sable2/ack_cover_03_frantic.ogg", "seconds": 1.90, "lufs": -19.5 },
    { "voice": "sable2", "text": "I\u0027ve got your back. For now.", "norm": "I\u0027VE GOT YOUR BACK. FOR NOW.", "intensity": "tense", "file": "vo/sable2/ack_cover_03_tense.ogg", "seconds": 1.84, "lufs": -21.5 },
    { "voice": "sable2", "text": "Copy. Engines only.", "norm": "COPY. ENGINES ONLY.", "intensity": "frantic", "file": "vo/sable2/ack_disable_01_frantic.ogg", "seconds": 1.31, "lufs": -19.5 },
    { "voice": "sable2", "text": "Copy. Engines only.", "norm": "COPY. ENGINES ONLY.", "intensity": "tense", "file": "vo/sable2/ack_disable_01_tense.ogg", "seconds": 1.34, "lufs": -21.5 },
    { "voice": "sable2", "text": "Disabling - just let it sit there.", "norm": "DISABLING - JUST LET IT SIT THERE.", "intensity": "frantic", "file": "vo/sable2/ack_disable_02_frantic.ogg", "seconds": 1.89, "lufs": -19.5 },
    { "voice": "sable2", "text": "Disabling - just let it sit there.", "norm": "DISABLING - JUST LET IT SIT THERE.", "intensity": "tense", "file": "vo/sable2/ack_disable_02_tense.ogg", "seconds": 2.02, "lufs": -21.5 },
    { "voice": "sable2", "text": "Going for the engines.", "norm": "GOING FOR THE ENGINES.", "intensity": "frantic", "file": "vo/sable2/ack_disable_03_frantic.ogg", "seconds": 1.35, "lufs": -19.5 },
    { "voice": "sable2", "text": "Going for the engines.", "norm": "GOING FOR THE ENGINES.", "intensity": "tense", "file": "vo/sable2/ack_disable_03_tense.ogg", "seconds": 1.42, "lufs": -21.5 },
    { "voice": "sable2", "text": "Forming up.", "norm": "FORMING UP.", "intensity": "frantic", "file": "vo/sable2/ack_form_01_frantic.ogg", "seconds": 1.14, "lufs": -19.5 },
    { "voice": "sable2", "text": "Forming up.", "norm": "FORMING UP.", "intensity": "tense", "file": "vo/sable2/ack_form_01_tense.ogg", "seconds": 1.02, "lufs": -21.5 },
    { "voice": "sable2", "text": "Coming back in. Nice and boring.", "norm": "COMING BACK IN. NICE AND BORING.", "intensity": "frantic", "file": "vo/sable2/ack_form_02_frantic.ogg", "seconds": 1.90, "lufs": -19.5 },
    { "voice": "sable2", "text": "Coming back in. Nice and boring.", "norm": "COMING BACK IN. NICE AND BORING.", "intensity": "tense", "file": "vo/sable2/ack_form_02_tense.ogg", "seconds": 2.02, "lufs": -21.5 },
    { "voice": "sable2", "text": "On your wing.", "norm": "ON YOUR WING.", "intensity": "frantic", "file": "vo/sable2/ack_form_03_frantic.ogg", "seconds": 1.07, "lufs": -19.5 },
    { "voice": "sable2", "text": "On your wing.", "norm": "ON YOUR WING.", "intensity": "tense", "file": "vo/sable2/ack_form_03_tense.ogg", "seconds": 0.95, "lufs": -21.5 },
    { "voice": "sable2", "text": "Drones, three of them, low on your port side. Whenever you\u0027re ready.", "norm": "DRONES, THREE OF THEM, LOW ON YOUR PORT SIDE. WHENEVER YOU\u0027RE READY.", "intensity": "frantic", "file": "vo/sable2/cabin_choir_in_frantic.ogg", "seconds": 3.25, "lufs": -19.5 },
    { "voice": "sable2", "text": "That\u0027s the last of them. Sable flight, form up.", "norm": "THAT\u0027S THE LAST OF THEM. SABLE FLIGHT, FORM UP.", "intensity": "calm", "file": "vo/sable2/cabin_clear.ogg", "seconds": 4.15, "lufs": -23.0 },
    { "voice": "sable2", "text": "Port drive\u0027s back. Whatever you did, do it again.", "norm": "PORT DRIVE\u0027S BACK. WHATEVER YOU DID, DO IT AGAIN.", "intensity": "tense", "file": "vo/sable2/cabin_engine_back_tense.ogg", "seconds": 2.86, "lufs": -21.5 },
    { "voice": "sable2", "text": "Lector\u0027s coming out of the ice. Everybody go dark. Get up and pull your breaker, Sable 1. Now.", "norm": "LECTOR\u0027S COMING OUT OF THE ICE. EVERYBODY GO DARK. GET UP AND PULL YOUR BREAKER, SABLE 1. NOW.", "intensity": "tense", "file": "vo/sable2/cabin_go_dark_tense.ogg", "seconds": 5.16, "lufs": -21.5 },
    { "voice": "sable2", "text": "Sable 1, you\u0027re venting. Port drive\u0027s gone. Somebody out there has very good aim.", "norm": "SABLE 1, YOU\u0027RE VENTING. PORT DRIVE\u0027S GONE. SOMEBODY OUT THERE HAS VERY GOOD AIM.", "intensity": "frantic", "file": "vo/sable2/cabin_hit_frantic.ogg", "seconds": 3.51, "lufs": -19.5 },
    { "voice": "sable2", "text": "It looked right through us. Nobody breathe yet.", "norm": "IT LOOKED RIGHT THROUGH US. NOBODY BREATHE YET.", "intensity": "calm", "file": "vo/sable2/cabin_missed.ogg", "seconds": 3.27, "lufs": -23.0 },
    { "voice": "sable2", "text": "Get your power back, Sable 1. Breaker. Then get that engine seated. I\u0027ll cover.", "norm": "GET YOUR POWER BACK, SABLE 1. BREAKER. THEN GET THAT ENGINE SEATED. I\u0027LL COVER.", "intensity": "frantic", "file": "vo/sable2/cabin_power_up_frantic.ogg", "seconds": 3.48, "lufs": -19.5 },
    { "voice": "sable2", "text": "Quiet out here. I don\u0027t like it.", "norm": "QUIET OUT HERE. I DON\u0027T LIKE IT.", "intensity": "calm", "file": "vo/sable2/cabin_quiet.ogg", "seconds": 2.50, "lufs": -23.0 },
    { "voice": "sable2", "text": "That\u0027s torn it. Drones inbound. Heads up.", "norm": "THAT\u0027S TORN IT. DRONES INBOUND. HEADS UP.", "intensity": "frantic", "file": "vo/sable2/cabin_spotted_reply_frantic.ogg", "seconds": 2.13, "lufs": -19.5 },
    { "voice": "sable2", "text": "Target\u0027s dead in the water.", "norm": "TARGET\u0027S DEAD IN THE WATER.", "intensity": "tense", "file": "vo/sable2/disabled_01_tense.ogg", "seconds": 1.42, "lufs": -21.5 },
    { "voice": "sable2", "text": "Engines gone. It\u0027s not going anywhere.", "norm": "ENGINES GONE. IT\u0027S NOT GOING ANYWHERE.", "intensity": "tense", "file": "vo/sable2/disabled_02_tense.ogg", "seconds": 2.08, "lufs": -21.5 },
    { "voice": "sable2", "text": "Mercy\u0027s gone.", "norm": "MERCY\u0027S GONE.", "intensity": "frantic", "file": "vo/sable2/dogfight_lost_capital_frantic.ogg", "seconds": 1.07, "lufs": -19.5 },
    { "voice": "sable2", "text": "Sable 2 is gone.", "norm": "SABLE 2 IS GONE.", "intensity": "frantic", "file": "vo/sable2/dogfight_sable2_lost_frantic.ogg", "seconds": 1.22, "lufs": -19.5 },
    { "voice": "sable2", "text": "Lost Sable 3. Keep flying.", "norm": "LOST SABLE 3. KEEP FLYING.", "intensity": "frantic", "file": "vo/sable2/dogfight_sable3_lost_frantic.ogg", "seconds": 1.65, "lufs": -19.5 },
    { "voice": "sable2", "text": "That\u0027s the lot. Warden\u0027s gone.", "norm": "THAT\u0027S THE LOT. WARDEN\u0027S GONE.", "intensity": "calm", "file": "vo/sable2/dogfight_won.ogg", "seconds": 3.13, "lufs": -23.0 },
    { "voice": "sable2", "text": "Oh my God, the Lector is breaking up!!! Look at it!!!", "norm": "OH MY GOD, THE LECTOR IS BREAKING UP!!! LOOK AT IT!!!", "intensity": "tense", "file": "vo/sable2/escort_lector_down_tense.ogg", "seconds": 3.31, "lufs": -21.5 },
    { "voice": "sable2", "text": "Lector\u0027s sweeping for life signs. Power down now or it\u0027ll see you!", "norm": "LECTOR\u0027S SWEEPING FOR LIFE SIGNS. POWER DOWN NOW OR IT\u0027LL SEE YOU!", "intensity": "tense", "file": "vo/sable2/escort_lector_sweep_tense.ogg", "seconds": 3.40, "lufs": -21.5 },
    { "voice": "sable2", "text": "Tamsin\u0027s gone. All of them.", "norm": "TAMSIN\u0027S GONE. ALL OF THEM.", "intensity": "frantic", "file": "vo/sable2/escort_lost_frantic.ogg", "seconds": 1.64, "lufs": -19.5 },
