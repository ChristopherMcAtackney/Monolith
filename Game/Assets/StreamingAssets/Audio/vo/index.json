    { "voice": "sable2", "text": "Lector\u0027s sweeping for life signs. If you had a breaker to pull, now would be the time.", "norm": "LECTOR\u0027S SWEEPING FOR LIFE SIGNS. IF YOU HAD A BREAKER TO PULL, NOW WOULD BE THE TIME.", "intensity": "tense", "file": "vo/sable2/escort_lector_sweep_tense.ogg", "seconds": 3.99, "lufs": -21.5 },
    { "voice": "sable2", "text": "Tamsin\u0027s gone. All of them.", "norm": "TAMSIN\u0027S GONE. ALL OF THEM.", "intensity": "frantic", "file": "vo/sable2/escort_lost_frantic.ogg", "seconds": 1.64, "lufs": -19.5 },
