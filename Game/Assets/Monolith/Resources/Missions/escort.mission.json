{
  "format": "monolith-mission/1",
  "id": "escort",
  "name": "The Crossing",
  "about": "The second test mission (design section 11, quality bar 5: made from data alone, no code change). Escort a damaged freighter, the Tamsin, seven kilometres to its jump point. A quiet opening that turns; Earth's drones in waves on FS2's two-thirds rule; Earth's corvette Lector shadows the crossing and sweeps for life signs (the cabin's scan, a stub for now: being seen brings more drones); bomber waves arrive on the Lector's hull thresholds (70% and 40%, FS2's 'Slaying Ravana' pattern); our reinforcements arrive in a relay, each a few seconds after the last is lost.",
  "difficulty": "Medium",
  "player": "Sable 1",
  "teams": ["diaspora", "earth"],
  "arrivalCap": { "team": "earth", "value": [2, 3, 4, 5, 6], "valueWhy": "ours: an escort is busier than it looks, so a smaller cap than the dogfight's" },
  "music": { "start": "ambient", "auto": true, "tracks": { "ambient": "crossing_ambient", "battle1": "crossing_battle_1", "battle2": "crossing_battle_2", "battle3": "crossing_battle_3" } },
  "pacing": { "hulls": ["Tamsin", "Lector"] },
  "briefing": {
    "title": "The Crossing",
    "stages": [
      "The Tamsin is a freighter with a cooked drive and four hundred people aboard. It is limping seven kilometres to the jump point, and Earth knows it.",
      "Sable 1 and 2 fly escort. Lantern and Wick are on call, one after the other, if you lose ground."
    ],
    "questions": [
      { "q": "What are the objectives", "a": "Get the Tamsin to the jump point. Anything else is a bonus." },
      { "q": "What opposition will there be", "a": "Drones, in waves. A picket corvette, the Lector, somewhere on the route: hurt it and it will call bombers." },
      { "q": "Can we hide from the scan", "a": "If you go dark it may take you for wreckage. Your call." }
    ]
  },
  "debriefing": [
    { "when": { "objective": "tamsin" }, "text": "The Tamsin made the jump. Four hundred people owe you a drink. Collect it in person." },
    { "when": { "objective": "tamsin", "is": "failed" }, "text": "We lost the Tamsin. Nobody gets a drink." },
    { "when": { "objective": "lector" }, "text": "The Lector won't be sweeping anything again." },
    { "when": { "detected": "Lector" }, "text": "The Lector saw you. Next time, think about the breaker." }
  ],

  "ships": [
    { "name": "Sable 1", "class": "vanguard_fighter", "team": "diaspora",
      "arrival": { "at": [-160, 50, 120], "rot": [0, 0, 0], "speed": 0.35 } },
    { "name": "Sable 2", "class": "vanguard_fighter", "team": "diaspora", "ai": "wingman", "wingman": true,
      "ammo": { "missile_heat": 4, "missile_lock": 2, "torpedo_heavy": 0 },
      "goal": { "order": "guard", "target": "Tamsin" },
      "arrival": { "near": "Sable 1", "offset": [-30, 5, -30], "speed": 0.35 } },
    { "name": "Tamsin", "class": "diaspora_freighter", "team": "diaspora", "hull": 70, "hullScale": 6, "selfHeal": false,
      "hullWhy": "ours: the 'damaged freighter' of the brief starts at 70%; six times a Triton's hull (21,000 at the start) so it lives through one bomber wave's two torpedoes (13,600) and not two waves': difficulty scales only the player's damage, so this is the same on every level",
      "capital": { "turretProfile": "diaspora_turret", "turretWaitScale": 1.3 },
      "look": { "hull": { "length": 140, "width": 36, "height": 30, "seed": 41 } },
      "goal": { "order": "waypoints", "path": [[0, 0, 2400], [500, 150, 4800], [0, 0, 6400]], "speed": 0.8, "then": "stop" },
      "goalWhy": "24 m/s across six and a half kilometres, then the 'Spooling' event flies it on to the jump: five minutes of crossing",
      "arrival": { "at": [0, 0, 0], "rot": [0, 0, 0], "speed": 0.8 } },
    { "name": "Lector", "class": "earth_corvette", "team": "earth", "hullScale": 0.2,
      "hullScaleWhy": "ours: a lightly built picket, 16,000 of the Deimos' 80,000, so an escort's guns and torpedoes can bring it to its thresholds between waves",
      "capital": { "standoff": 1800, "band": 300, "bearing": 80, "throttle": 0.35, "turretProfile": "earth_turret", "turretWaitScale": 1.6, "beamWaitScale": 4,
                   "holdBeams": true, "weapons": { "SUB_aaf_F01": "beam_slash", "SUB_aaf_F03": "beam_slash" },
                   "holdBeamsWhy": "ours: a slash beam would cut the freighter in half before the escort could act; the Lector is a flak platform and the bombers' caller" },
      "arrival": { "cue": { "range": "Tamsin", "to": [0, 0, 7000], "below": 4300 }, "at": [-1800, 250, 4600], "facing": "Tamsin", "speed": 0.35 } }
  ],

  "wings": [
    { "name": "Matins", "team": "earth", "capped": true,
      "ships": [ { "class": "earth_interceptor", "ai": "drone", "count": 3 } ],
      "arrival": { "cue": false, "at": [1600, 300, 3600], "facing": "Tamsin", "speed": 0.9 } },
    { "name": "Lauds", "team": "earth", "capped": true,
      "ships": [ { "class": "earth_interceptor", "ai": "drone", "count": 2 },
                 { "class": "earth_interceptor", "ai": "drone", "count": 2, "goal": { "order": "attack", "target": "Tamsin" } } ],
      "arrival": { "cue": false, "at": [-2000, -200, 2600], "facing": "Tamsin", "speed": 0.9 } },
    { "name": "Prime", "team": "earth", "capped": true,
      "ships": [ { "class": "earth_interceptor", "ai": "drone", "count": 2 },
                 { "class": "earth_fighter", "ai": "drone", "count": 2, "goal": { "order": "attack", "target": "Tamsin" } } ],
      "arrival": { "cue": false, "at": [1800, 400, 6200], "facing": "Tamsin", "speed": 0.9 } },
    { "name": "Terce", "team": "earth", "capped": false, "waves": 2, "waveThreshold": 1, "waveDelay": 8,
      "waveWhy": "FS2's wing waves: a second Terce comes eight seconds after the first is down to one ship (or when the Tamsin reaches the jump point: 'Final push'), so the run to the jump point stays contested",
      "cappedWhy": "Earth's last throw at the climax is not held back by the arrival cap: behind a cap full of the earlier waves' survivors it could wait for minutes and miss the climax",
      "ships": [ { "class": "earth_interceptor", "ai": "drone", "count": 3 } ],
      "arrival": { "cue": false, "at": [-1500, 200, 7800], "facing": "Tamsin", "speed": 0.9 } },
    { "name": "Compline", "team": "earth",
      "ships": [ { "class": "earth_heavy", "ai": "drone_heavy", "count": 2 } ],
      "goal": { "order": "attack", "target": "Tamsin" },
      "arrival": { "cue": { "detected": "Lector" }, "delay": 6, "near": "Lector", "distance": 600, "facing": "Tamsin", "speed": 0.8 },
      "arrivalWhy": "being seen is not a failure (design section 3): the Lector calls two heavy fighters on the life signs it found" },
    { "name": "Thurible", "team": "earth",
      "ships": [ { "class": "earth_bomber", "ai": "drone_bomber", "role": "bomber", "count": 2, "ammo": { "torpedo_heavy": 1 } } ],
      "goal": { "order": "bomb", "target": "Tamsin" },
      "arrival": { "cue": { "or": [ { "hull": "Lector", "below": 70 },
                                    { "and": [ { "event": "Holding" }, { "not": { "destroyed": "Lector" } } ] } ] },
                   "near": "Lector", "distance": 900, "facing": "Tamsin", "formation": "line", "spacing": [60, 0, 30], "speed": 0.9 },
      "arrivalWhy": "FS2's 'Slaying Ravana': reinforcements when the big target's hull drops below 70%, then 40% (Incense). Left alone, the Lector still throws these bombers in when the Tamsin reaches the jump point, so the bombers are a beat of every crossing (in its climax), not only of the ones where the escort goes for the corvette" },
    { "name": "Acolyte", "team": "earth",
      "ships": [ { "class": "earth_heavy", "ai": "drone_heavy", "count": 2 } ],
      "goal": { "order": "guard", "target": "Thurible" },
      "arrival": { "cue": { "arrived": "Thurible" }, "near": "Lector", "distance": 900, "facing": "Tamsin", "offsets": [[-140, 60, -110], [140, 60, -110]], "speed": 0.9 } },
    { "name": "Incense", "team": "earth",
      "ships": [ { "class": "earth_bomber", "ai": "drone_bomber", "role": "bomber", "count": 2, "ammo": { "torpedo_heavy": 1 } } ],
      "goal": { "order": "bomb", "target": "Tamsin" },
      "arrival": { "cue": { "hull": "Lector", "below": 40 }, "near": "Tamsin", "distance": 2600, "facing": "Tamsin", "formation": "line", "spacing": [60, 0, 30], "speed": 0.9 } },
    { "name": "Lantern", "team": "diaspora", "wingmen": true,
      "ships": [ { "class": "vanguard_fighter", "ai": "wingman", "count": 2, "ammo": { "missile_heat": 4, "missile_lock": 2, "torpedo_heavy": 0 } } ],
      "goal": { "order": "guard", "target": "Tamsin" },
      "arrival": { "cue": { "or": [ { "destroyed": "Sable 2", "delay": 6 }, { "hull": "Tamsin", "below": 45 } ] }, "near": "Tamsin", "offset": [0, 120, -400], "speed": 0.6 },
      "arrivalWhy": "the relay (design section 7): our next flight jumps in a few seconds after the last is lost, or when the Tamsin is in trouble" },
    { "name": "Wick", "team": "diaspora", "wingmen": true,
      "ships": [ { "class": "vanguard_fighter", "ai": "wingman", "count": 2, "ammo": { "missile_heat": 4, "missile_lock": 2, "torpedo_heavy": 0 } } ],
      "goal": { "order": "guard", "target": "Tamsin" },
      "arrival": { "cue": { "destroyed": "Lantern", "delay": 8 }, "near": "Tamsin", "offset": [200, 100, -500], "speed": 0.6 } }
  ],

  "objectives": [
    { "id": "tamsin", "kind": "primary", "text": "Get the Tamsin to the jump point", "complete": { "departed": "Tamsin" }, "fail": { "destroyed": "Tamsin" } },
    { "id": "lector", "kind": "secondary", "text": "Destroy the Lector", "complete": { "destroyed": "Lector" } },
    { "id": "bombers", "kind": "secondary", "text": "Stop the Thurible bombers", "complete": { "destroyed": "Thurible" } },
    { "id": "unseen", "kind": "bonus", "text": "Get through without the Lector finding you", "hidden": true,
      "complete": { "and": [ { "departed": "Tamsin" }, { "not": { "detected": "Lector" } } ] }, "fail": { "detected": "Lector" } }
  ],

  "messages": [
    { "id": "open_tamsin", "from": "Tamsin", "text": "Tamsin to escort. Drive's cooked and the aft holds are open to space. We make the jump point if nobody shoots at us. Somebody will.", "seconds": 6 },
    { "id": "open_sable2", "from": "Sable 2", "text": "Five minutes of nothing. I could get used to that." },
    { "id": "matins", "from": "Lector", "fallbackFrom": "#EARTH", "text": "A vessel of the fallen, crawling home. How touching." },
    { "id": "lauds", "from": "Lector", "fallbackFrom": "#EARTH", "text": "Every remnant ends. Yours ends here." },
    { "id": "prime", "from": "Lector", "fallbackFrom": "#EARTH", "text": "You brought them to us. That was a kindness." },
    { "id": "terce", "from": "Lector", "fallbackFrom": "#EARTH", "text": "The door you run for is a grave. Go on." },
    { "id": "lector_here", "from": "Lector", "text": "Lector. You carry four hundred biologics. We will count them as they freeze.", "priority": "high" },
    { "id": "lector_sweep", "from": "Sable 2", "text": "Lector's sweeping for life signs. If you had a breaker to pull, now would be the time.", "priority": "high" },
    { "id": "spotted", "from": "Lector", "text": "There you are.", "priority": "high" },
    { "id": "thurible", "from": "Lector", "text": "Censers, go. Bring me the ark.", "priority": "high" },
    { "id": "thurible_ours", "from": "Tamsin", "text": "Bombers on the scope. They're coming for us. Please don't let them.", "priority": "high" },
    { "id": "incense", "from": "Lector", "fallbackFrom": "#EARTH", "text": "Burn it. Burn all of it.", "priority": "high" },
    { "id": "tamsin_hurt", "from": "Tamsin", "text": "Tamsin here. We're venting from three places now. Hurry it up.", "priority": "high" },
    { "id": "lantern", "from": "Lantern 1", "text": "Lantern flight, jumping in. Sorry we're late. Traffic.", "priority": "high" },
    { "id": "wick", "from": "Wick 1", "text": "Wick flight. Last ones in the barrel. Make it count.", "priority": "high" },
    { "id": "sable2_lost", "from": "Tamsin", "text": "Your wingman's gone. We saw it. Sorry.", "priority": "high" },
    { "id": "lector_down", "from": "<any wingman>", "text": "Lector's breaking up. Shame.", "priority": "normal" },
    { "id": "hold", "from": "Tamsin", "text": "We're at the jump point and the drive's still cold. Keep them off us.", "priority": "high" },
    { "id": "terce2", "from": "Lector", "fallbackFrom": "#EARTH", "text": "More of us than there are of you. There always will be.", "priority": "high" },
    { "id": "spool", "from": "Tamsin", "text": "Spooling what's left of the drive. Keep them off us for twenty seconds.", "priority": "high" },
    { "id": "away", "from": "#Tamsin", "text": "We're through. Drinks are on us. Somebody else is paying.", "priority": "high" },
    { "id": "lost", "from": "<any wingman>", "text": "Tamsin's gone. All of them.", "priority": "high" }
  ],

  "events": [
    { "name": "Opening", "when": { "time": 2 }, "do": [ { "do": "radio", "message": "open_tamsin" } ] },
    { "name": "Opening reply", "after": "Opening", "afterDelay": 9, "do": [ { "do": "radio", "message": "open_sable2" } ] },
    { "name": "Matins in", "when": { "range": "Tamsin", "to": [0, 0, 7000], "below": 5600 },
      "whenWhy": "the quiet opening turns once the Tamsin is a kilometre and a half along (about a minute)",
      "do": [ { "do": "arrive", "ship": "Matins" }, { "do": "radio", "message": "matins" } ] },
    { "name": "Lauds in", "whenWhy": "FS2's campaign pairs the two-thirds rule with a time-out from the last wave's arrival: the next wave 5 s after this one is two-thirds destroyed, or 75 s after it was called (even if the arrival cap still holds some of it back), so a drone that wanders off cannot stall the crossing", "when": { "or": [ { "and": [ { "arrived": "Matins" }, { "destroyedPercent": "Matins", "atLeast": 66 } ] }, { "event": "Matins in", "delay": 70 } ] }, "delay": 5,
      "do": [ { "do": "arrive", "ship": "Lauds" }, { "do": "radio", "message": "lauds" } ] },
    { "name": "Prime in", "when": { "or": [ { "and": [ { "arrived": "Lauds" }, { "destroyedPercent": "Lauds", "atLeast": 66 } ] }, { "event": "Lauds in", "delay": 70 } ] }, "delay": 5,
      "do": [ { "do": "arrive", "ship": "Prime" }, { "do": "radio", "message": "prime" } ] },
    { "name": "Terce in", "when": { "or": [ { "and": [ { "arrived": "Prime" }, { "destroyedPercent": "Prime", "atLeast": 66 } ] }, { "event": "Prime in", "delay": 70 } ] }, "delay": 5,
      "do": [ { "do": "arrive", "ship": "Terce" }, { "do": "radio", "message": "terce" } ] },
    { "name": "Lector here", "when": { "arrived": "Lector" },
      "do": [ { "do": "radio", "message": "lector_here" }, { "do": "music", "state": "battle3", "for": 30 } ] },
    { "name": "Lector sweeps", "when": { "arrived": "Lector", "delay": 3 },
      "do": [ { "do": "scan", "from": "Lector", "seconds": 10, "range": 6000 }, { "do": "radio", "message": "lector_sweep" } ] },
    { "name": "Spotted", "when": { "detected": "Lector" }, "do": [ { "do": "radio", "message": "spotted" } ] },
    { "name": "Thurible in", "when": { "arrived": "Thurible" }, "do": [ { "do": "radio", "message": "thurible" }, { "do": "radio", "message": "thurible_ours" } ] },
    { "name": "Incense in", "when": { "arrived": "Incense" }, "do": [ { "do": "radio", "message": "incense" } ] },
    { "name": "Tamsin hurt", "when": { "hull": "Tamsin", "below": 40 }, "do": [ { "do": "radio", "message": "tamsin_hurt" } ] },
    { "name": "Lantern here", "when": { "arrived": "Lantern", "any": true }, "do": [ { "do": "radio", "message": "lantern" } ] },
    { "name": "Wick here", "when": { "arrived": "Wick", "any": true }, "do": [ { "do": "radio", "message": "wick" } ] },
    { "name": "Sable 2 lost", "when": { "destroyed": "Sable 2" }, "do": [ { "do": "radio", "message": "sable2_lost" } ] },
    { "name": "Lector down", "when": { "destroyed": "Lector" }, "directive": { "text": "Destroy the Lector", "show": { "arrived": "Lector" } },
      "do": [ { "do": "radio", "message": "lector_down" } ] },
    { "name": "Final push", "when": { "and": [ { "event": "Holding" }, { "event": "Terce in" } ] },
      "whenWhy": "with the freighter at the door Earth throws in what it has left: Terce's second wave now, if the wave rule has not sent it already",
      "do": [ { "do": "cond", "cases": [ { "if": { "not": { "arrived": "Terce 4", "any": true } }, "then": [ { "do": "arrive", "ship": "Terce" } ] } ] } ] },
    { "name": "Spooling", "when": { "and": [ { "range": "Tamsin", "to": [0, 0, 6500], "below": 400 },
                                           { "or": [ { "arrived": "Terce 4", "delay": 8 }, { "event": "Terce in", "delay": 120 } ] } ] },
      "whenWhy": "the drive spools once the Tamsin is at the jump point and Earth's last wing is in, both its waves (8 s after the second, so it is a scramble; a safety net 120 s after the first): the climax follows the fight, not just the freighter's speed",
      "do": [ { "do": "radio", "message": "spool" }, { "do": "depart", "ship": "Tamsin", "to": [0, 0, 7400], "jumpAfter": 20 } ] },
    { "name": "Holding", "when": { "and": [ { "range": "Tamsin", "to": [0, 0, 6500], "below": 400 }, { "not": { "event": "Spooling" } } ] },
      "whenWhy": "reaching the jump point before Earth has played its last hand, the Tamsin creeps on with its drive cold rather than sailing past",
      "do": [ { "do": "order", "ship": "Tamsin", "order": "waypoints", "path": [[0, 0, 6850]], "speed": 0.08, "then": "stop" }, { "do": "radio", "message": "hold" } ] },
    { "name": "Terce again", "when": { "arrived": "Terce 4" }, "do": [ { "do": "radio", "message": "terce2" } ] },
    { "name": "Autopilot", "when": { "autopilot": true }, "repeat": -1, "interval": 5, "log": false,
      "about": "Only when the AI flies the player's ship (soaks, checks, captures): an escort's plan. Bombers, or two or more fighters within a kilometre of the Tamsin, first; the Lector (the secondary objective, and the bombers' caller) when the freighter is clear; otherwise stay on the Tamsin. Sable 2 and the relay flights guard the freighter.",
      "do": [ { "do": "cond", "cases": [
        { "if": { "or": [ { "and": [ { "arrived": "Thurible", "any": true }, { "not": { "destroyed": "Thurible" } } ] },
                          { "and": [ { "arrived": "Incense", "any": true }, { "not": { "destroyed": "Incense" } } ] },
                          { "hostilesNear": "Tamsin", "within": 1000, "atLeast": 2 } ] },
          "then": [ { "do": "order", "ship": "<player>", "order": "guard", "target": "Tamsin" } ] },
        { "if": { "and": [ { "arrived": "Lector" }, { "not": { "destroyed": "Lector" } } ] }, "then": [ { "do": "order", "ship": "<player>", "order": "attack", "target": "Lector" } ] },
        { "else": [ { "do": "order", "ship": "<player>", "order": "guard", "target": "Tamsin" } ] } ] } ] },
    { "name": "Tamsin lost", "when": { "destroyed": "Tamsin" },
      "do": [ { "do": "radio", "message": "lost" }, { "do": "end", "result": "defeat", "text": "TAMSIN LOST" } ] },
    { "name": "Tamsin away", "when": { "departed": "Tamsin", "delay": 4 },
      "do": [ { "do": "radio", "message": "away" }, { "do": "end", "result": "victory", "text": "TAMSIN AWAY" } ] },

    { "name": "Escort", "when": { "departed": "Tamsin" }, "directive": "Escort the Tamsin to the jump point" },
    { "name": "Matins down", "when": { "destroyed": "Matins" }, "directive": { "text": "Destroy Matins", "show": { "arrived": "Matins", "any": true } } },
    { "name": "Lauds down", "when": { "destroyed": "Lauds" }, "directive": { "text": "Destroy Lauds", "show": { "arrived": "Lauds", "any": true } } },
    { "name": "Prime down", "when": { "destroyed": "Prime" }, "directive": { "text": "Destroy Prime", "show": { "arrived": "Prime", "any": true } } },
    { "name": "Bombers down", "when": { "destroyed": "Thurible" }, "directive": { "text": "Stop the bombers", "show": { "arrived": "Thurible", "any": true } } }
  ],

  "autoplay": {
    "seconds": 900, "difficulty": "Medium", "invulnerable": true,
    "expect": {
      "result": ["victory"],
      "fired": ["Opening", "Matins in", "Lauds in", "Prime in", "Terce in", "Terce again", "Lector here", "Lector sweeps", "Spotted", "Thurible in", "Lantern here", "Spooling", "Tamsin away"],
      "notFired": ["Tamsin lost"],
      "order": ["Opening", "Matins in", "Lauds in", "Prime in", "Terce in", "Terce again", "Spooling", "Tamsin away"],
      "longestQuietMax": 30, "maxEngagingMax": 4, "threatsAvgMin": 1.5
    }
  }
}
