  "messages": [
    { "id": "mercy_open", "from": "Small Mercy", "intensity": "calm", "text": "Small Mercy to Sable flight. We're through, seven kilometres short of the outpost. Take it slow.", "seconds": 6 },
    { "id": "sable2_open", "from": "Sable 2", "intensity": "calm", "text": "Sable 2. Ice everywhere. Nothing on the scope that moves.", "seconds": 4 },
    { "id": "sable3_open", "from": "Sable 3", "intensity": "calm", "text": "Sable 3, on your right. Quiet out here.", "seconds": 4 },
    { "id": "mercy_target", "from": "Small Mercy", "intensity": "calm", "text": "The bright point dead ahead is the outpost. Earth calls it the Oculus. It listens to everything that comes in past the cloud.", "seconds": 7 },
    { "id": "sable2_quiet", "from": "Sable 2", "intensity": "calm", "text": "Then we keep it down.", "seconds": 3 },
    { "id": "oculus_sweep", "from": "Oculus", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "The cloud is counted. Every grain of it.", "seconds": 4 },
    { "id": "missed", "from": "Sable 2", "intensity": "calm", "text": "It went past us. Stay dark a moment longer.", "priority": "high", "seconds": 4 },
    { "id": "oculus_blind", "from": "Oculus", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "Ice. Only ice, and the wreckage the fallen leave behind them.", "seconds": 5 },
    { "id": "spotted", "from": "Oculus", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "Life. Warm, frightened life. The Oculus sees you.", "priority": "high", "seconds": 4 },
    { "id": "spotted_reply", "from": "Sable 2", "intensity": "tense", "text": "That's us found. They'll be ready for us now.", "priority": "high", "seconds": 4 },
    { "id": "weapons_free", "from": "Small Mercy", "intensity": "tense", "text": "All Sable ships, weapons free. Take the outpost's guns first.", "priority": "high", "seconds": 4 },
    { "id": "comms_start", "from": "Small Mercy", "intensity": "tense", "text": "The outpost is calling home. Knock out its comms array before the call gets through.", "priority": "high", "seconds": 6 },
    { "id": "oculus_wake", "from": "Oculus", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "You have come to the door of the house you were born in. Kneel there.", "seconds": 5 },
    { "id": "scramble", "from": "Sable 3", "intensity": "frantic", "text": "Fighters out of the outpost's hangar. Here they come.", "priority": "high", "seconds": 4 },
    { "id": "hangar_hint", "from": "Small Mercy", "intensity": "tense", "text": "Their hangar's on the ice face, toward us. Shut it and they stop launching.", "seconds": 5 },
    { "id": "kyrie", "from": "Oculus", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "The choir assembles.", "seconds": 3 },
    { "id": "split", "from": "Sable 2", "intensity": "frantic", "text": "Two groups, left and right of the Mercy. I'll take the left.", "priority": "high", "seconds": 4 },
    { "id": "gloria", "from": "Oculus", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "Glory to those who stayed.", "seconds": 3 },
    { "id": "agnus", "from": "Oculus", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "Lie down, remnant. It is easier.", "seconds": 3 },
    { "id": "agnus_reply", "from": "Sable 3", "intensity": "frantic", "text": "Contacts behind the Mercy, high.", "priority": "high", "seconds": 3 },
    { "id": "sanctus", "from": "Oculus", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "The house is struck. Its servants come.", "seconds": 4 },
    { "id": "comms_half", "from": "Small Mercy", "intensity": "tense", "text": "They're still transmitting. Half the warning's out, maybe more.", "priority": "high", "seconds": 5 },
    { "id": "comms_down", "from": "Small Mercy", "intensity": "tense", "text": "Comms array is down. Nobody further in heard that.", "priority": "high", "seconds": 4 },
    { "id": "warning_out", "from": "Small Mercy", "intensity": "frantic", "text": "The warning got out. Earth knows we're here. Expect company.", "priority": "high", "seconds": 5 },
    { "id": "dies_irae", "from": "#EARTH", "intensity": "calm", "text": "The fallen have come home. Their home will receive them.", "priority": "high", "seconds": 5 },
    { "id": "dies_irae_reply", "from": "Sable 3", "intensity": "frantic", "text": "Heavies and bombers behind the Mercy. That's the company.", "priority": "high", "seconds": 4 },
    { "id": "cantor_here", "from": "Cantor", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "This is the Cantor. Your names are not written anywhere.", "seconds": 4 },
    { "id": "cantor_warn", "from": "Small Mercy", "intensity": "frantic", "text": "Corvette on our port side. Watch its flak.", "priority": "high", "seconds": 4 },
    { "id": "cantor_hurt", "from": "Sable 2", "intensity": "tense", "text": "Corvette's hurting. Keep at it.", "seconds": 3 },
    { "id": "cantor_sable3", "from": "Sable 3", "intensity": "tense", "text": "I'll work on the corvette.", "seconds": 3 },
    { "id": "cantor_running", "from": "Sable 2", "intensity": "tense", "text": "Corvette's breaking off. Let it go.", "priority": "high", "seconds": 3 },
    { "id": "cantor_down", "from": "Sable 3", "intensity": "tense", "text": "Corvette's breaking up.", "seconds": 3 },
    { "id": "archon_here", "from": "Archon", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "Archon. I was made to end things like you.", "priority": "high", "seconds": 4 },
    { "id": "archon_warn", "from": "Small Mercy", "intensity": "frantic", "text": "Destroyer, starboard bow. It's charging beams.", "priority": "high", "seconds": 4 },
    { "id": "beam_hit", "from": "Small Mercy", "intensity": "frantic", "text": "We're hit. That went through three decks. Somebody get on those beam turrets.", "priority": "high", "seconds": 5 },
    { "id": "bombers", "from": "Small Mercy", "intensity": "frantic", "text": "Bombers out of the destroyer's hangar, coming for us.", "priority": "high", "seconds": 4 },
    { "id": "archon_bombers", "from": "Archon", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "Bring me the ark.", "seconds": 3 },
    { "id": "heavy_hit", "from": "Sable 2", "intensity": "frantic", "text": "Sable 1, you're venting. Your drive's gone.", "priority": "high", "seconds": 4 },
    { "id": "engine_back", "from": "Sable 2", "intensity": "tense", "text": "Drive's back. Good.", "seconds": 3 },
    { "id": "mercy_hurt", "from": "Small Mercy", "intensity": "frantic", "text": "Hull's at half. We can take one more of those, maybe two.", "priority": "high", "seconds": 5 },
    { "id": "beams_down", "from": "Small Mercy", "intensity": "tense", "text": "Destroyer's beams are out. Ours are free.", "priority": "high", "seconds": 4 },
    { "id": "beams_lost", "from": "Small Mercy", "intensity": "frantic", "text": "Destroyer's beams are out. So are ours. Patience, we need you now.", "priority": "high", "seconds": 5 },
    { "id": "patience_in", "from": "Small Mercy", "intensity": "tense", "text": "Patience is through, off the outpost's face. Keep its guns off her.", "priority": "high", "seconds": 5 },
    { "id": "benedictus", "from": "Sable 3", "intensity": "frantic", "text": "More fighters out of the destroyer.", "priority": "high", "seconds": 3 },
    { "id": "libera", "from": "Archon", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "Come to me, all of you.", "seconds": 3 },
    { "id": "archon_down", "from": "Sable 3", "intensity": "frantic", "text": "Destroyer's going up. Get clear of it.", "priority": "high", "seconds": 3 },
    { "id": "outpost_turn", "from": "Small Mercy", "intensity": "tense", "text": "All Sable ships, on the outpost. Finish it.", "priority": "high", "seconds": 4 },
    { "id": "oculus_dying", "from": "Oculus", "fallbackFrom": "#EARTH", "intensity": "calm", "text": "The eye closes. Others will open.", "seconds": 4 },
    { "id": "outpost_down", "from": "Sable 2", "intensity": "tense", "text": "Outpost's down.", "priority": "high", "seconds": 3 },
    { "id": "withdraw", "from": "Small Mercy", "intensity": "tense", "text": "Earth's ships are pulling out. Let them go.", "priority": "high", "seconds": 4 },
    { "id": "won", "from": "<any wingman>", "intensity": "calm", "text": "That's it. Let's go home before somebody comes looking.", "seconds": 4 },
    { "id": "sable2_lost", "from": "<any wingman>", "intensity": "tense", "text": "Sable 2's gone.", "priority": "high", "seconds": 3 },
    { "id": "sable3_lost", "from": "<any wingman>", "intensity": "tense", "text": "Lost Sable 3.", "priority": "high", "seconds": 3 },
    { "id": "lantern_in", "from": "Lantern 1", "intensity": "tense", "text": "Lantern flight, coming in behind the Mercy.", "priority": "high", "seconds": 4 },
    { "id": "wick_in", "from": "Wick 1", "intensity": "tense", "text": "Wick flight. We are here now.", "priority": "high", "seconds": 4 },
    { "id": "mercy_lost", "from": "<any wingman>", "intensity": "frantic", "text": "The Mercy's gone.", "priority": "high", "seconds": 3 }
  ],

  "events": [
    { "name": "Opening", "when": { "time": 7 }, "do": [ { "do": "radio", "message": "mercy_open" } ] },
    { "name": "Opening 2", "after": "Opening", "afterDelay": 8, "do": [ { "do": "radio", "message": "sable2_open" }, { "do": "radio", "message": "sable3_open" } ] },
    { "name": "Opening 3", "after": "Opening 2", "afterDelay": 14, "do": [ { "do": "radio", "message": "mercy_target" } ] },
    { "name": "Opening 4", "after": "Opening 3", "afterDelay": 9, "do": [ { "do": "radio", "message": "sable2_quiet" } ] },

    { "name": "Go dark", "when": { "time": 62 }, "failWhen": { "event": "Alerted" },
      "do": [ { "do": "callOut", "from": "Sable 2", "intensity": "calm", "text": "Sweep's coming. Everybody dark. Get up and pull your breaker, Sable 1.", "prompt": "Leave the seat: pull the main breaker" },
              { "do": "music", "state": "ambient" } ],
      "directive": { "text": "Go dark: pull the main breaker", "show": { "powered": true } } },
    { "name": "Sweep", "after": "Go dark", "afterDelay": 22, "failWhen": { "event": "Alerted" },
      "do": [ { "do": "scan", "from": "Oculus", "seconds": 14, "range": 14000 }, { "do": "radio", "message": "oculus_sweep" } ],
      "directive": { "text": "Hold still until the sweep passes", "show": { "powered": false } } },
    { "name": "Missed", "when": { "and": [ { "event": "Sweep", "delay": 15 }, { "not": { "detected": "Oculus" } } ] },
      "do": [ { "do": "radio", "message": "missed" }, { "do": "radio", "message": "oculus_blind" } ] },
    { "name": "Alerted", "when": { "or": [ { "detected": "Oculus" }, { "and": [ { "hull": "Oculus", "below": 99 }, { "not": { "event": "Strike" } } ] } ] },
      "whenWhy": "being seen is not a failure: the outpost wakes now, scrambles sooner and starts its warning sooner; so does shooting at it before the strike (the go-dark beat is then skipped)",
      "do": [ { "do": "radio", "message": "spotted" }, { "do": "radio", "message": "spotted_reply" }, { "do": "turrets", "ship": "Oculus", "fire": true }, { "do": "music", "state": "battle1", "for": 20 } ] },
    { "name": "Power up", "when": { "event": "Sweep", "delay": 18 },
      "do": [ { "do": "callOut", "from": "Sable 2", "intensity": "tense", "text": "Sweep's past. Power up, Sable 1. We go now.", "prompt": "Power up and sit down" } ],
      "directive": { "text": "Power up and take the seat", "show": { "or": [ { "powered": false }, { "seated": false } ] } } },
    { "name": "Strike", "when": { "or": [ { "and": [ { "event": "Power up" }, { "powered": true }, { "seated": true } ] }, { "event": "Power up", "delay": 45 },
                                          { "and": [ { "event": "Alerted", "delay": 6 }, { "not": { "event": "Sweep" } } ] } ] },
      "whenWhy": "the strike goes when the player is back in the seat with the power on (or 45 s after the call: the wing goes without you); if the player opened fire before the sweep, six seconds after the outpost woke",
      "do": [ { "do": "radio", "message": "weapons_free" },
              { "do": "order", "ship": "Sable 2", "order": "engage" }, { "do": "order", "ship": "Sable 3", "order": "engage" },
              { "do": "music", "state": "battle1" }, { "do": "music", "auto": true } ] },
    { "name": "Wake", "when": { "event": "Strike", "delay": 8 }, "do": [ { "do": "turrets", "ship": "Oculus", "fire": true }, { "do": "radio", "message": "oculus_wake" } ] },
    { "name": "Warning starts", "when": { "or": [ { "event": "Alerted", "delay": 4 }, { "event": "Strike", "delay": 12 } ] },
      "do": [ { "do": "radio", "message": "comms_start" } ],
      "directive": { "text": "Knock out the outpost's comms array", "show": { "not": { "subsystem": "Oculus", "kind": "comms", "destroyed": true } } } },
    { "name": "Scramble", "when": { "or": [ { "event": "Alerted", "delay": 14 }, { "event": "Strike", "delay": 30 } ] },
      "do": [ { "do": "arrive", "ship": "Introit" }, { "do": "radio", "message": "scramble" } ] },
    { "name": "Hangar hint", "after": "Scramble", "afterDelay": 10, "when": { "not": { "subsystem": "Oculus", "kind": "hangar", "destroyed": true } },
      "do": [ { "do": "radio", "message": "hangar_hint" } ],
      "directive": { "text": "Shut the outpost's hangar", "show": { "not": { "subsystem": "Oculus", "kind": "hangar", "destroyed": true } } } },

    { "name": "Kyrie in", "when": { "or": [ { "and": [ { "arrived": "Introit" }, { "destroyedPercent": "Introit", "atLeast": 22 } ] }, { "event": "Scramble", "delay": 70 } ] }, "delay": 5,
      "whenWhy": "the first wave from outside comes when the outpost's first scramble is two-thirds down (two of its nine-ship total is 22%), or 75 s after the scramble",
      "do": [ { "do": "arrive", "ship": "Kyrie" }, { "do": "radio", "message": "kyrie" } ] },
    { "name": "Gloria and Credo in", "when": { "or": [ { "and": [ { "arrived": "Kyrie" }, { "destroyedPercent": "Kyrie", "atLeast": 66 } ] }, { "event": "Kyrie in", "delay": 70 } ] }, "delay": 5,
      "whenWhy": "FS2's two-thirds rule with a time-out 75 s after the last wave was called; two wings at once, on opposite sides of the Mercy",
      "do": [ { "do": "arrive", "ship": "Gloria" }, { "do": "arrive", "ship": "Credo" }, { "do": "radio", "message": "gloria" }, { "do": "radio", "message": "split" } ] },
    { "name": "Agnus in", "when": { "or": [ { "and": [ { "arrived": "Gloria" }, { "arrived": "Credo" }, { "destroyedPercent": ["Gloria", "Credo"], "atLeast": 66 } ] }, { "event": "Gloria and Credo in", "delay": 70 } ] }, "delay": 5,
      "do": [ { "do": "arrive", "ship": "Agnus" }, { "do": "radio", "message": "agnus" }, { "do": "radio", "message": "agnus_reply" } ] },
    { "name": "Sanctus here", "when": { "arrived": "Sanctus", "any": true }, "do": [ { "do": "radio", "message": "sanctus" } ] },

    { "name": "Comms half", "when": { "and": [ { "event": "Warning starts", "delay": 105 }, { "not": { "subsystem": "Oculus", "kind": "comms", "destroyed": true } } ] },
      "do": [ { "do": "radio", "message": "comms_half" } ] },
    { "name": "Comms down", "when": { "and": [ { "subsystem": "Oculus", "kind": "comms", "destroyed": true }, { "not": { "event": "Warning out" } } ] },
      "do": [ { "do": "radio", "message": "comms_down" } ] },
    { "name": "Warning out", "when": { "and": [ { "event": "Warning starts", "delay": 210 }, { "not": { "subsystem": "Oculus", "kind": "comms", "destroyed": true } } ] },
      "whenWhy": "ours: three and a half minutes from the start of the warning to the end of it; the heavier response follows (Dies Irae)",
      "do": [ { "do": "radio", "message": "warning_out" } ] },
    { "name": "Dies Irae here", "when": { "arrived": "Dies Irae", "any": true },
      "do": [ { "do": "radio", "message": "dies_irae" }, { "do": "radio", "message": "dies_irae_reply" }, { "do": "music", "state": "battle3", "for": 30 } ] },

    { "name": "Cantor here", "when": { "arrived": "Cantor" },
      "do": [ { "do": "radio", "message": "cantor_here" }, { "do": "radio", "message": "cantor_warn" }, { "do": "radio", "message": "cantor_sable3" },
              { "do": "order", "ship": "Sable 3", "order": "attack", "target": "Cantor" }, { "do": "music", "state": "battle2", "for": 20 } ] },
    { "name": "Cantor hurt", "when": { "hull": "Cantor", "below": 70 }, "do": [ { "do": "radio", "message": "cantor_hurt" } ] },
    { "name": "Cantor runs", "when": { "and": [ { "hull": "Cantor", "below": 40 }, { "not": { "destroyed": "Cantor" } } ] },
      "whenWhy": "FS2's damaged ship that withdraws: a corvette hurt this badly breaks off and jumps out",
      "do": [ { "do": "radio", "message": "cantor_running" }, { "do": "depart", "ship": "Cantor", "jumpAfter": 12 } ] },
    { "name": "Cantor down", "when": { "destroyed": "Cantor" }, "do": [ { "do": "radio", "message": "cantor_down" } ] },
    { "name": "Cantor gone", "when": { "or": [ { "destroyed": "Cantor" }, { "departed": "Cantor" } ] },
      "do": [ { "do": "order", "ship": "Sable 3", "order": "engage" } ],
      "directive": { "text": "Destroy or drive off the Cantor", "show": { "arrived": "Cantor" } } },
    { "name": "Archon here", "when": { "arrived": "Archon" },
      "do": [ { "do": "radio", "message": "archon_here" }, { "do": "radio", "message": "archon_warn" }, { "do": "music", "state": "battle3", "for": 40 } ] },
    { "name": "Beam hit", "when": { "and": [ { "arrived": "Archon" }, { "hull": "Small Mercy", "below": 85 }, { "beaming": "Archon" } ] }, "do": [ { "do": "radio", "message": "beam_hit" } ] },
    { "name": "Bombers out", "when": { "arrived": "Thurible", "any": true }, "do": [ { "do": "radio", "message": "bombers" }, { "do": "radio", "message": "archon_bombers" } ] },
    { "name": "Bombers down", "when": { "destroyed": "Thurible" }, "directive": { "text": "Stop the bombers", "show": { "arrived": "Thurible", "any": true } } },
    { "name": "Heavy hit", "when": { "event": "Archon here", "delay": 28 },
      "whenWhy": "the dramatic point: half a minute into the destroyer's arrival, a heavy hit takes the player's drive, which only a hand repair brings back",
      "do": [ { "do": "knockOut", "ship": "<player>", "part": "engine" }, { "do": "radio", "message": "heavy_hit" },
              { "do": "callOut", "from": "Sable 2", "intensity": "frantic", "text": "Get up and seat that drive. I'll cover you.", "prompt": "Leave the seat: seat the drive by hand" },
              { "do": "order", "ship": "Sable 2", "order": "guard", "target": "Sable 1" } ],
      "directive": { "text": "Seat the drive by hand at the aft starboard panel", "show": { "needsRepair": "<player>" } } },
    { "name": "Engine back", "when": { "and": [ { "event": "Heavy hit" }, { "not": { "needsRepair": "<player>" } } ] },
      "do": [ { "do": "radio", "message": "engine_back" }, { "do": "order", "ship": "Sable 2", "order": "engage" } ] },
    { "name": "Mercy hurt", "when": { "hull": "Small Mercy", "below": 50 }, "do": [ { "do": "radio", "message": "mercy_hurt" } ] },

    { "name": "Archon crippled", "when": { "and": [ { "arrived": "Archon" }, { "not": { "destroyed": "Archon" } },
                                                    { "or": [ { "subsystem": "Archon", "kind": "turret", "destroyed": true }, { "disabled": "Archon" } ] } ] },
      "whenWhy": "the climax: with the destroyer's beam turrets (or its engines) gone, the Mercy comes off its beam-lock; if the destroyer's slashes have already cut the Mercy's own beam turrets, the Patience is called at once",
      "do": [ { "do": "cond", "cases": [ { "if": { "subsystem": "Small Mercy", "kind": "turret", "destroyed": true }, "then": [ { "do": "radio", "message": "beams_lost" } ] },
                                       { "else": [ { "do": "radio", "message": "beams_down" } ] } ] },
              { "do": "beams", "ship": "Small Mercy", "free": true }, { "do": "music", "state": "battle3", "for": 30 } ],
      "directive": { "text": "Destroy the Archon's beam turrets or its engines", "show": { "arrived": "Archon" } } },
    { "name": "Patience here", "when": { "arrived": "Patience" }, "do": [ { "do": "radio", "message": "patience_in" } ] },
    { "name": "Benedictus here", "when": { "arrived": "Benedictus", "any": true }, "do": [ { "do": "radio", "message": "benedictus" } ] },
    { "name": "Libera here", "when": { "arrived": "Libera", "any": true }, "do": [ { "do": "radio", "message": "libera" } ] },
    { "name": "Archon down", "when": { "destroyed": "Archon" }, "do": [ { "do": "radio", "message": "archon_down" } ] },
    { "name": "Outpost next", "when": { "arrived": "Patience" }, "delay": 8,
      "do": [ { "do": "radio", "message": "outpost_turn" }, { "do": "order", "ship": "Sable 2", "order": "attack", "target": "Oculus" }, { "do": "order", "ship": "Sable 3", "order": "attack", "target": "Oculus" } ] },
    { "name": "Oculus dying", "when": { "hull": "Oculus", "below": 15 }, "do": [ { "do": "radio", "message": "oculus_dying" } ] },
    { "name": "Outpost down", "when": { "destroyed": "Oculus" },
      "do": [ { "do": "radio", "message": "outpost_down" }, { "do": "invulnerable", "ship": "Small Mercy" } ],
      "doWhy": "the job is done and Earth is leaving: the Mercy is not lost to a stray fighter in the last twenty seconds",
      "directive": { "text": "Destroy the Oculus", "show": { "event": "Strike" } } },
    { "name": "Earth withdraws", "when": { "event": "Outpost down", "delay": 5 },
      "do": [ { "do": "radio", "message": "withdraw" },
              { "do": "depart", "ship": "Cantor", "jumpAfter": 6 },
              { "do": "cond", "cases": [ { "if": { "not": { "disabled": "Archon" } }, "then": [ { "do": "depart", "ship": "Archon", "jumpAfter": 8 } ] } ] },
              { "do": "depart", "ship": "Introit", "jumpAfter": 5 }, { "do": "depart", "ship": "Kyrie", "jumpAfter": 5 }, { "do": "depart", "ship": "Gloria", "jumpAfter": 5 },
              { "do": "depart", "ship": "Credo", "jumpAfter": 5 }, { "do": "depart", "ship": "Agnus", "jumpAfter": 5 }, { "do": "depart", "ship": "Sanctus", "jumpAfter": 5 },
              { "do": "depart", "ship": "Thurible", "jumpAfter": 5 }, { "do": "depart", "ship": "Acolyte", "jumpAfter": 5 }, { "do": "depart", "ship": "Dies Irae", "jumpAfter": 5 },
              { "do": "depart", "ship": "Benedictus", "jumpAfter": 5 }, { "do": "depart", "ship": "Libera", "jumpAfter": 5 },
              { "do": "music", "state": "ambient", "for": 20 } ] },
    { "name": "Victory", "when": { "event": "Earth withdraws", "delay": 14 },
      "do": [ { "do": "radio", "message": "won" }, { "do": "end", "result": "victory", "text": "OUTPOST DOWN" } ] },
    { "name": "Mercy lost", "when": { "and": [ { "destroyed": "Small Mercy" }, { "not": { "event": "Outpost down" } } ] },
      "do": [ { "do": "radio", "message": "mercy_lost" }, { "do": "end", "result": "defeat", "text": "SMALL MERCY LOST" } ] },

    { "name": "Sable 2 lost", "when": { "destroyed": "Sable 2" }, "do": [ { "do": "radio", "message": "sable2_lost" } ] },
    { "name": "Sable 3 lost", "when": { "destroyed": "Sable 3" }, "do": [ { "do": "radio", "message": "sable3_lost" } ] },
    { "name": "Lantern here", "when": { "arrived": "Lantern", "any": true }, "do": [ { "do": "radio", "message": "lantern_in" } ] },
    { "name": "Wick here", "when": { "arrived": "Wick", "any": true }, "do": [ { "do": "radio", "message": "wick_in" } ] },
    { "name": "Mercy flying", "when": { "event": "Outpost down" }, "directive": { "text": "Keep the Small Mercy flying", "show": { "event": "Strike" } } },

    { "name": "Autopilot", "when": { "autopilot": true }, "repeat": -1, "interval": 5, "log": false,
      "about": "Only when the AI flies the player's ship (soaks, checks, captures): the plan of a player who goes for the objectives. Wait with the Mercy until the strike; the destroyer's beam turrets first once the Mercy is below 60%; the bombers; then the beam turrets anyway; the comms array while the warning runs; the Mercy if it is crowded; the corvette; the crippled destroyer until the Patience comes; then the outpost; the outpost's hangar and guns; otherwise a free fight.",
      "do": [ { "do": "cond", "cases": [
        { "if": { "not": { "event": "Strike" } }, "then": [ { "do": "order", "ship": "<player>", "order": "guard", "target": "Small Mercy" } ] },
        { "if": { "and": [ { "arrived": "Archon" }, { "not": { "destroyed": "Archon" } }, { "not": { "subsystem": "Archon", "kind": "turret", "destroyed": true } }, { "hull": "Small Mercy", "below": 60 } ] },
          "then": [ { "do": "order", "ship": "<player>", "order": "attack", "target": "Archon", "partKind": "turret" } ] },
        { "if": { "and": [ { "arrived": "Thurible", "any": true }, { "not": { "destroyed": "Thurible" } } ] }, "then": [ { "do": "order", "ship": "<player>", "order": "attack", "target": "Thurible" } ] },
        { "if": { "and": [ { "arrived": "Archon" }, { "not": { "destroyed": "Archon" } }, { "not": { "subsystem": "Archon", "kind": "turret", "destroyed": true } } ] },
          "then": [ { "do": "order", "ship": "<player>", "order": "attack", "target": "Archon", "partKind": "turret" } ] },
        { "if": { "and": [ { "event": "Warning starts" }, { "not": { "event": "Warning out" } }, { "not": { "subsystem": "Oculus", "kind": "comms", "destroyed": true } } ] },
          "then": [ { "do": "order", "ship": "<player>", "order": "attack", "target": "Oculus", "partKind": "comms" } ] },
        { "if": { "hostilesNear": "Small Mercy", "within": 1500, "atLeast": 3 }, "then": [ { "do": "order", "ship": "<player>", "order": "guard", "target": "Small Mercy" } ] },
        { "if": { "and": [ { "arrived": "Cantor" }, { "not": { "destroyed": "Cantor" } }, { "not": { "departed": "Cantor" } } ] }, "then": [ { "do": "order", "ship": "<player>", "order": "attack", "target": "Cantor" } ] },
        { "if": { "and": [ { "event": "Archon crippled" }, { "not": { "destroyed": "Archon" } }, { "not": { "event": "Patience here" } } ] }, "then": [ { "do": "order", "ship": "<player>", "order": "attack", "target": "Archon" } ] },
        { "if": { "event": "Patience here" }, "then": [ { "do": "order", "ship": "<player>", "order": "attack", "target": "Oculus" } ] },
        { "if": { "and": [ { "event": "Strike" }, { "not": { "subsystem": "Oculus", "kind": "hangar", "destroyed": true } } ] },
          "then": [ { "do": "order", "ship": "<player>", "order": "attack", "target": "Oculus", "partKind": "hangar" } ] },
        { "if": { "and": [ { "event": "Strike" }, { "not": { "destroyed": "Oculus" } } ] }, "then": [ { "do": "order", "ship": "<player>", "order": "attack", "target": "Oculus", "partKind": "aaf" } ] },
        { "else": [ { "do": "order", "ship": "<player>", "order": "engage" } ] } ] } ] }
  ],

  "autoplay": {
    "seconds": 1200, "difficulty": "Medium", "invulnerable": true,
