{
  "format": "monolith-mission/1",
  "id": "selftest",
  "name": "Mission self-test",
  "about": "The mission system's own checks (-mnMissionSelfTest): every condition and action on a small, quiet world. Earth's ships are invulnerable and far off; the test code kills ships and parts at set times and checks when each event fires. Not a mission to fly.",
  "player": "Sable 1",
  "teams": ["diaspora", "earth"],
  "arrivalCap": { "team": "earth", "value": [1, 1, 2, 3, 3] },
  "music": { "start": "ambient", "auto": false, "tracks": { "battle2": "test_battle_2" } },
  "pacing": { "hulls": ["Mercy", "Warden"] },
  "briefing": { "title": "Self-test", "stages": ["Nothing to fly."], "questions": [ { "q": "What is this?", "a": "The checks." } ] },
  "debriefing": [ { "when": { "objective": "choir" }, "text": "Choir went down." }, { "when": false, "text": "Never shown." } ],
  "ships": [
    { "name": "Sable 1", "class": "vanguard_fighter", "team": "diaspora", "invulnerable": true, "arrival": { "at": [0, 0, 0], "speed": 0.3 } },
    { "name": "Sable 2", "class": "vanguard_fighter", "team": "diaspora", "ai": "wingman", "wingman": true, "invulnerable": true,
      "goal": { "order": "engage" }, "fallback": { "order": "guard", "target": "Sable 1" }, "arrival": { "near": "Sable 1", "offset": [-30, 5, -30], "speed": 0.3 } },
    { "name": "Mercy", "class": "diaspora_cruiser", "team": "diaspora", "selfHeal": false, "capital": { "holdBeams": true, "stationary": true, "turretWaitScale": 50 },
      "arrival": { "at": [0, -300, -2000], "speed": 0 } },
    { "name": "Warden", "class": "earth_corvette", "team": "earth", "hullScale": 0.5, "invulnerable": true,
      "capital": { "stationary": true, "turretWaitScale": 50, "beamWaitScale": 50, "holdBeams": true, "weapons": { "SUB_aaf_F01": "beam_slash", "SUB_aaf_F03": "beam_slash" } },
      "arrival": { "at": [0, 0, 9000], "rot": [0, 180, 0], "speed": 0 } },
    { "name": "Late", "class": "earth_interceptor", "team": "earth", "ai": "drone", "invulnerable": true,
      "arrival": { "cue": { "destroyed": "Choir 1", "delay": 1 }, "at": [3000, 0, 7000], "facing": "Sable 1", "speed": 0.3 } },
    { "name": "Runner", "class": "earth_interceptor", "team": "earth", "ai": "drone", "invulnerable": true,
      "goal": { "order": "waypoints", "path": [[-4000, 500, 8000], [-4000, 500, 8600]], "then": "loop", "speed": 0.4 },
      "arrival": { "at": [-4000, 500, 8000], "facing": [0, 0, 1], "speed": 0.4 } }
  ],
  "wings": [
    { "name": "Choir", "team": "earth", "capped": true, "ships": [ { "class": "earth_interceptor", "ai": "drone", "count": 3, "invulnerable": true } ],
      "arrival": { "cue": false, "at": [2000, 200, 7000], "facing": "Sable 1", "speed": 0.3 } },
    { "name": "Relay", "team": "earth", "waves": 2, "waveThreshold": 0, "waveDelay": 2, "ships": [ { "class": "earth_interceptor", "count": 2, "invulnerable": true } ],
      "arrival": { "cue": { "time": 20 }, "near": "Warden", "distance": 900, "speed": 0.2 } }
  ],
  "objectives": [
    { "id": "choir", "kind": "primary", "text": "Destroy Choir", "complete": { "destroyed": "Choir" } },
    { "id": "mercy", "kind": "secondary", "text": "Keep the Mercy alive", "fail": { "destroyed": "Mercy" } },
    { "id": "spotted", "kind": "bonus", "text": "Be seen", "hidden": true, "complete": { "event": "spotted" } }
  ],
  "messages": [
    { "id": "a", "from": "Sable 2", "text": "Normal one.", "priority": "normal", "seconds": 2 },
    { "id": "b", "from": "#Command", "text": "High one.", "priority": "high", "seconds": 2, "voice": "voice/test_b.wav" },
    { "id": "c", "from": "Sable 2", "text": "Low one.", "priority": "low" },
    { "id": "gone", "from": "Choir 1", "fallbackFrom": "#EARTH", "text": "From a dead ship." }
  ],
  "events": [
    { "name": "t5", "when": { "time": 5 }, "do": [ { "do": "arrive", "ship": "Choir" }, { "do": "radio", "message": "a" }, { "do": "radio", "message": "b" }, { "do": "radio", "message": "c" }, { "do": "music", "state": "battle2" } ] },
    { "name": "chained", "after": "t5", "afterDelay": 1, "do": [ { "do": "log", "text": "chained" } ] },
    { "name": "ticker", "repeat": 3, "interval": 2, "do": [ { "do": "log", "text": "tick" } ] },
    { "name": "logic", "when": { "and": [ { "time": 1 }, { "not": { "destroyed": "Mercy" } }, { "or": [ false, { "time": 2 } ] } ] } },
    { "name": "fail me", "when": false, "failWhen": { "time": 3 } },
    { "name": "event delay", "when": { "event": "t5", "delay": 2 } },
    { "name": "in range", "when": { "range": "Sable 1", "to": "Mercy", "below": 3000 } },
    { "name": "far", "when": { "range": "<player>", "to": [0, 0, 0], "above": 100000 } },
    { "name": "two thirds", "when": { "and": [ { "arrived": "Choir" }, { "destroyedPercent": "Choir", "atLeast": 66 } ] }, "delay": 2 },
    { "name": "choir 3 dead", "when": { "destroyed": "Choir 3", "delay": 3 } },
    { "name": "mercy hurt", "when": { "hull": "Mercy", "below": 50 } },
    { "name": "beams down", "when": { "subsystem": "Warden", "parts": ["SUB_aaf_F01", "SUB_aaf_F03"], "destroyed": true }, "do": [ { "do": "beams", "ship": "Mercy", "free": true } ] },
    { "name": "warden disabled", "when": { "disabled": "Warden", "delay": 1 } },
    { "name": "objective done", "when": { "objective": "choir", "is": "complete" } },
    { "name": "kill choir", "when": { "destroyed": "Choir" }, "directive": { "text": "Destroy Choir", "show": { "arrived": "Choir", "any": true } } },
    { "name": "scan", "when": { "time": 16 }, "do": [ { "do": "scan", "from": "Warden", "seconds": 2, "range": 20000 } ] },
    { "name": "spotted", "when": { "detected": "Warden" } },
    { "name": "knock", "when": { "time": 17 }, "do": [ { "do": "knockOut", "ship": "<player>", "part": "engine" }, { "do": "cabinLights", "state": "emergency" }, { "do": "callOut", "text": "Get up and fix it.", "prompt": "Leave the seat" } ] },
    { "name": "needs repair", "when": { "needsRepair": "<player>" } },
    { "name": "repaired", "when": { "and": [ { "event": "needs repair" }, { "not": { "needsRepair": "<player>" } } ] } },
    { "name": "cabin flags", "when": { "and": [ { "seated": true }, { "powered": true } ] } },
    { "name": "branch", "when": { "time": 19 }, "do": [ { "do": "cond", "cases": [ { "if": { "destroyed": "Mercy" }, "then": [ { "do": "log", "text": "wrong branch" } ] }, { "if": { "time": 19 }, "then": [ { "do": "log", "text": "right branch" } ] }, { "else": [ { "do": "log", "text": "else branch" } ] } ] } ] },
    { "name": "relay 2 in", "when": { "arrived": "Relay 3" } },
    { "name": "orders", "when": { "time": 21 }, "do": [ { "do": "order", "ship": "Relay", "order": "guard", "target": "Warden", "standing": true }, { "do": "order", "ship": "Sable 2", "order": "form", "target": "<player>" } ] },
    { "name": "leave", "when": { "time": 25 }, "do": [ { "do": "depart", "ship": "Late", "jumpAfter": 2 }, { "do": "order", "ship": "Runner", "order": "waypoints", "path": [[-4000, 500, 8300]], "then": "depart" }, { "do": "invulnerable", "ship": "Mercy", "on": true } ] },
    { "name": "late gone", "when": { "departed": "Late" } },
    { "name": "departed hull", "when": { "or": [ { "hull": "Late", "below": 50 }, { "subsystem": "Late", "kind": "engine", "destroyed": true } ] } },
    { "name": "runner gone", "when": { "departed": "Runner" } },
    { "name": "earth count", "when": { "teamAlive": "earth", "atLeast": 3 } },
    { "name": "hostiles near", "when": { "hostilesNear": "<player>", "within": 20000 } },
    { "name": "easy or harder", "when": { "difficultyAtLeast": "Easy" } },
    { "name": "no autopilot", "when": { "autopilot": false } },
    { "name": "warden beaming", "when": { "beaming": "Warden" } },
    { "name": "dead speaker", "when": { "time": 30 }, "do": [ { "do": "radio", "message": "gone" } ] },
    { "name": "the end", "when": { "and": [ { "event": "late gone" }, { "event": "runner gone" }, { "time": 45 } ] }, "do": [ { "do": "end", "result": "victory", "text": "TEST OVER" } ] },
    { "name": "after the end", "when": { "time": 46 } }
  ]
}
